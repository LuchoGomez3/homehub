# HomeHub - Monorepo Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# SHARED (used by both API and Web)
# ============================================
NODE_ENV=development

# ============================================
# API (Fastify Backend)
# ============================================
# Server
API_PORT=3001
API_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3000

# Security (generate with: openssl rand -base64 32)
COOKIE_SECRET=
JWT_SECRET=
JWT_REFRESH_SECRET=

# Database (PostgreSQL)
DATABASE_URL=postgresql://homehub:homehub_dev_password@localhost:5432/homehub

# Redis
REDIS_URL=redis://localhost:6379

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000

# Email (use MailHog/SendGrid/Resend in production)
EMAIL_FROM=noreply@homehub.local
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USER=
EMAIL_PASS=

# Web Push (optional)
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:admin@homehub.local

# ============================================
# WEB (Next.js Frontend)
# ============================================
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000