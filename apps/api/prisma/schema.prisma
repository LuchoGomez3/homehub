generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MEMBER
}

enum ExpenseCategory {
  FOOD
  TRANSPORT
  HOUSING
  UTILITIES
  HEALTH
  EDUCATION
  ENTERTAINMENT
  CLOTHING
  OTHER
}

enum BillCategory {
  SERVICES
  TAXES
  DEBTS
  INSURANCE
  OTHER
}

enum BillStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum TodoStatus {
  PENDING
  IN_PROGRESS
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ShoppingCategory {
  PANTRY
  CLEANING
  FRESH
  FROZEN
  BEVERAGES
  PERSONAL_CARE
  PET
  OTHER
}

enum Recurrence {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

model Family {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members       User[]
  expenses      Expense[]
  bills         Bill[]
  todos         Todo[]
  shoppingItems ShoppingItem[]
  events        Event[]
  invitations   Invitation[]

  @@index([name])
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String
  avatar        String?
  role          UserRole  @default(MEMBER)
  language      String    @default("es")
  theme         String    @default("system")
  familyId      String
  family        Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  expenses      Expense[]     @relation("UserExpenses")
  assignedTodos Todo[]        @relation("AssignedTodos")
  events        Event[]       @relation("UserEvents")
  addedItems    ShoppingItem[] @relation("AddedShoppingItems")
  sentInvites   Invitation[]  @relation("SentInvitations")
  refreshTokens RefreshToken[]

  @@index([familyId])
  @@index([email])
}

/// Una sesion de larga duracion. Se guarda el hash SHA-256 del refresh
/// token, nunca el token plano: si la base se filtra, no se puede usar.
///
/// Rotacion: cada /refresh emite un token nuevo y marca este como
/// revocado, apuntando al que lo reemplazo. Si llega un token que ya
/// esta revocado es senal de reuso (robo): se revocan todas las
/// sesiones del usuario.
model RefreshToken {
  id           String        @id @default(cuid())
  tokenHash    String        @unique
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?       @unique
  replacedBy   RefreshToken? @relation("RefreshTokenRotation", fields: [replacedById], references: [id])
  replaces     RefreshToken? @relation("RefreshTokenRotation")
  createdAt    DateTime      @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Expense {
  id           String           @id @default(cuid())
  amount       Decimal          @db.Decimal(10, 2)
  category     ExpenseCategory
  description  String?
  date         DateTime
  isRecurring  Boolean          @default(false)
  recurrence   Recurrence?
  familyId     String
  family       Family           @relation(fields: [familyId], references: [id], onDelete: Cascade)
  userId       String
  user         User             @relation("UserExpenses", fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([familyId, date])
  @@index([familyId, category])
  @@index([familyId, userId])
}

model Bill {
  id          String       @id @default(cuid())
  name        String
  amount      Decimal      @db.Decimal(10, 2)
  dueDate     DateTime
  category    BillCategory
  status      BillStatus   @default(PENDING)
  recurrence  Recurrence   @default(MONTHLY)
  fileUrl     String?
  familyId    String
  family      Family       @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([familyId, dueDate])
  @@index([familyId, status])
  @@index([familyId, category])
}

model Todo {
  id          String      @id @default(cuid())
  title       String
  description String?
  status      TodoStatus  @default(PENDING)
  priority    Priority    @default(MEDIUM)
  dueDate     DateTime?
  familyId    String
  family      Family      @relation(fields: [familyId], references: [id], onDelete: Cascade)
  assigneeId  String?
  assignee    User?       @relation("AssignedTodos", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([familyId, status])
  @@index([familyId, assigneeId])
  @@index([familyId, dueDate])
}

model ShoppingItem {
  id        String          @id @default(cuid())
  name      String
  quantity  Int             @default(1)
  unit      String?
  category  ShoppingCategory
  isDone    Boolean         @default(false)
  addedById String
  addedBy   User            @relation("AddedShoppingItems", fields: [addedById], references: [id], onDelete: Cascade)
  familyId  String
  family    Family          @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([familyId, isDone])
  @@index([familyId, category])
}

model Event {
  id          String      @id @default(cuid())
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime
  allDay      Boolean     @default(false)
  recurrence  Recurrence?
  color       String?
  familyId    String
  family      Family      @relation(fields: [familyId], references: [id], onDelete: Cascade)
  attendees   User[]      @relation("UserEvents")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([familyId, startDate])
}

model Invitation {
  id          String    @id @default(cuid())
  email       String
  role        UserRole  @default(MEMBER)
  familyId    String
  family      Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  invitedById String
  invitedBy   User      @relation("SentInvitations", fields: [invitedById], references: [id], onDelete: Cascade)
  token       String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([familyId, email])
  @@index([token])
}