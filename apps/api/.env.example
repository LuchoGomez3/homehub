# App
NODE_ENV=development
PORT=3001
API_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3000
COOKIE_SECRET=your-super-secret-cookie-key-at-least-32-chars-long
JWT_SECRET=your-super-secret-jwt-key-at-least-32-chars-long
JWT_REFRESH_SECRET=your-super-secret-refresh-key-at-least-32-chars-long

# Database
DATABASE_URL=postgresql://homehub:homehub_dev_password@localhost:5432/homehub

# Redis
REDIS_URL=redis://localhost:6379

# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000

# Email (configure for production)
EMAIL_FROM=noreply@homehub.local
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USER=
EMAIL_PASS=

# Web Push (optional)
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:admin@homehub.local